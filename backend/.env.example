# backend/.env.example -- every setting the backend reads (app/core/config.py).
#
# Copy to `.env` in this folder and fill in the values. `.env` is listed in
# .gitignore and must never be committed: it holds the database password, the
# token-signing key and the AI keys. This file holds placeholders only.

# --- Database ---------------------------------------------------------------
# PostgreSQL through the pg8000 driver -- keep the `postgresql+pg8000://`
# prefix, or SQLAlchemy reaches for a driver that is not installed.
# A password containing @ : / ? # % must be PERCENT-ENCODED (@ -> %40,
# : -> %3A, / -> %2F, # -> %23, % -> %25), or the URL is split in the wrong
# place and the password is read as part of the host name.
DATABASE_URL=postgresql+pg8000://asset_app:CHANGE_ME@localhost:5432/asset_management

# --- Sessions ---------------------------------------------------------------
# Signs every session token and keys the stored SMTP password. REQUIRED: the
# server refuses to start without one at least 32 characters long. Generate:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Changing it signs everyone out and makes the saved SMTP password unreadable
# (re-enter it on Master Data > Notifications).
SECRET_KEY=
ALGORITHM=HS256
# 720 minutes = 12 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Seeded accounts (first start only) ---------------------------------------
# On a database with no accounts, four are created: this superadmin, plus
# admin, verifier and viewer. All four start on ADMIN_PASSWORD and must set
# their own at their first sign-in. REQUIRED for that first start; never read
# again after it. Do not reuse a password that is written down anywhere else.
ADMIN_USERNAME=superadmin
ADMIN_FULL_NAME=Super Administrator
ADMIN_PASSWORD=

# Starting password for people created from a bulk upload. They are flagged to
# change it before they can do anything, and assignees cannot sign in at all.
# Leave commented out to keep the built-in default; set it to rotate it.
# NEW_USER_DEFAULT_PASSWORD=

# --- Cross-origin access ----------------------------------------------------
# Leave EMPTY when nginx (or IIS) serves the app and proxies /api from the same
# address -- then no cross-origin request is ever made. Only list origins if
# the frontend really runs on a different address, e.g.
#   CORS_ORIGINS=https://itassets.example.com
# Never "*" in a deployment.
CORS_ORIGINS=

# --- Verification -------------------------------------------------------------
# true: new records wait in Verification until checked. false: straight in.
VERIFY_NEW_RECORDS=true

# --- Background jobs ------------------------------------------------------------
# The daily summary, renewal reminders and scheduled data export run inside the
# API process, each claiming its day in the database so they go out once even
# if several processes run. Set to 1 only on a process that must not send them.
DISABLE_SCHEDULER=

# --- In-app assistant (optional) ------------------------------------------------
# Without a key the assistant offers its built-in Guide only.
# gemini (default) or anthropic.
ASSISTANT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=medium
# Test-only overrides; leave empty.
GEMINI_BASE_URL=
ASSISTANT_BASE_URL=
