# IT Asset Engine: one site on the server's existing nginx, on its own port.
#
# Generated by deploy/install.sh from deploy/nginx.conf.template. Change the
# template and run install.sh again rather than editing the installed copy.

upstream asset_api {
    server 127.0.0.1:@@API_PORT@@;
    keepalive 16;
}

server {
    # `http2` on the listen line: nginx 1.24 predates the `http2 on` directive.
    listen @@PUBLIC_PORT@@ ssl http2;
    listen [::]:@@PUBLIC_PORT@@ ssl http2;
    server_name @@SERVER_NAME@@;

    ssl_certificate     @@CERT_FILE@@;
    ssl_certificate_key @@KEY_FILE@@;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Someone typing http:// on this port gets sent to https:// instead of
    # nginx's "plain HTTP request was sent to HTTPS port" error page.
    error_page 497 =301 https://$host:@@PUBLIC_PORT@@$request_uri;

    access_log /var/log/nginx/asset-management-access.log;
    error_log  /var/log/nginx/asset-management-error.log;

    # No Strict-Transport-Security header: HSTS covers every port of a host
    # name, so it would affect the other sites on this server.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;

    root @@SITE_DIR@@;
    index index.html;

    # A bulk upload is sent as one JSON body.
    client_max_body_size 25m;

    location ~ /\. {
        deny all;
        return 404;
    }

    location /api/ {
        proxy_pass http://asset_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The assistant waits on an AI provider, and the data export builds
        # every register into a zip; both can outlast the 60 s default.
        proxy_read_timeout 180s;
    }

    # `expires`, never add_header, in these locations: an add_header here
    # would drop every security header inherited from the server block.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    location / {
        expires -1;
        try_files $uri $uri/ /index.html;
    }
}
