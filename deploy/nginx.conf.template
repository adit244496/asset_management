# IT Asset Engine: one site on the server's existing nginx, on its own name.
#
# Generated by deploy/install.sh from deploy/nginx.conf.template. Change the
# template and run install.sh again rather than editing the installed copy.

upstream asset_api {
    server 127.0.0.1:@@API_PORT@@;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name @@SERVER_NAME@@;
    return 301 https://$host$request_uri;
}

server {
    # No `http2` here: on nginx 1.24 it would apply to this address and port as
    # a whole, which changes the other sites sharing 443.
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name @@SERVER_NAME@@;

    ssl_certificate     @@CERT_FILE@@;
    ssl_certificate_key @@KEY_FILE@@;
    ssl_protocols TLSv1.2 TLSv1.3;

    access_log /var/log/nginx/asset-management-access.log;
    error_log  /var/log/nginx/asset-management-error.log;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;

    root @@SITE_DIR@@;
    index index.html;

    # A bulk upload is sent as one JSON body.
    client_max_body_size 25m;

    location ~ /\. {
        deny all;
        return 404;
    }

    location /api/ {
        proxy_pass http://asset_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The assistant waits on an AI provider, and the data export builds
        # every register into a zip; both can outlast the 60 s default.
        proxy_read_timeout 180s;
    }

    # `expires`, never add_header, in these locations: an add_header here
    # would drop every security header inherited from the server block.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    location / {
        expires -1;
        try_files $uri $uri/ /index.html;
    }
}
