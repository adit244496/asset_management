# Production settings template. install.ps1 copies this to backend/.env and
# generates SECRET_KEY. Fill in every CHANGE_ME in backend/.env, never here:
# this file is committed to git, backend/.env is not.

# Percent-encode these characters in the password: @ : / ? # %
DATABASE_URL=postgresql+pg8000://asset_app:CHANGE_ME@localhost:5432/asset_management

SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Seeded accounts: superadmin, admin, verifier and viewer all start on this
# password and must replace it at first sign-in.
ADMIN_USERNAME=superadmin
ADMIN_FULL_NAME=Super Administrator
ADMIN_PASSWORD=CHANGE_ME

# Stays empty: nginx serves the app and the API from the same address.
CORS_ORIGINS=

VERIFY_NEW_RECORDS=true
DISABLE_SCHEDULER=

# Optional: without a key the assistant offers its built-in Guide only.
ASSISTANT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=medium
